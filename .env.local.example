# Fig Jam Charcuterie — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit it.

# Web3Forms access key for contact form submissions.
# Get yours free at https://web3forms.com — enter Liz's email, they email
# you an access key. No account needed for basic use.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL for sitemap, robots.txt, and canonical tags.
# Defaults to the current GitHub Pages URL.
# Update to https://www.figjamcharcuteriellc.com when custom domain is live.
NEXT_PUBLIC_SITE_URL=https://mhol1961.github.io/figjam-site
