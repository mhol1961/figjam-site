# Fig Jam Charcuterie — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit it.

# GoHighLevel inbound webhook URL for contact form submissions.
# After importing the GHL workflow, copy the webhook URL from the
# "Inbound Webhook" trigger and paste it here.
#
# Format looks like:
# https://services.leadconnectorhq.com/hooks/<location_id>/webhook-trigger/<webhook_id>
NEXT_PUBLIC_GHL_WEBHOOK_URL=
